<Window x:Class="Sraz.UI.Wpf.LeaderboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Sraz - Leaderboard" Height="420" Width="640" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Leaderboard" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,12"/>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Entries}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Player" Binding="{Binding PlayerName}" Width="*"/>
                <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="80"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/>
                <DataGridTextColumn Header="Difficulty" Binding="{Binding Difficulty}" Width="110"/>
                <DataGridTextColumn Header="Correct" Binding="{Binding CorrectAnswers}" Width="80"/>
                <DataGridTextColumn Header="Wrong" Binding="{Binding WrongAnswers}" Width="70"/>
                <DataGridTextColumn Header="Timeouts" Binding="{Binding Timeouts}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2" Content="Close" Width="140" Height="34" HorizontalAlignment="Center" Margin="0,18,0,0" Click="Close_Click"/>
    </Grid>
</Window>
