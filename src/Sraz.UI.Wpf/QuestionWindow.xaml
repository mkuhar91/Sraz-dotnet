<Window x:Class="Sraz.UI.Wpf.QuestionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Sraz - Question" Height="560" Width="920" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel>
            <TextBlock Text="{Binding Header}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" DockPanel.Dock="Left"/>
            <TextBlock Text="{Binding TimeLeftText}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right"/>
        </DockPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="{Binding QuestionText}" TextWrapping="Wrap" FontSize="26" Margin="0,0,0,20"/>
            <ItemsControl ItemsSource="{Binding Options}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding}" Height="44" Margin="0,0,0,10" Click="Answer_Click" IsEnabled="{Binding DataContext.CanAnswer, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Border Grid.Row="2" Background="#222" CornerRadius="8" Padding="12" Margin="0,10,0,0" Visibility="{Binding FeedbackVisible}">
            <StackPanel>
                <TextBlock Text="{Binding FeedbackTitle}" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="{Binding FeedbackExplanation}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="White"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding Footer}" HorizontalAlignment="Right" FontWeight="Bold" Margin="0,10,0,0"/>
    </Grid>
</Window>
