@page "/lobby/{Code}"
@namespace Sraz.UI.Blazor.Pages
@using Sraz.Application.Rooms
@using Microsoft.JSInterop
@implements IDisposable
@inject IRoomManager Rooms
@inject IPlayerIdentity Identity
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@Texts.Lobby – @Code</PageTitle>

<main class="lobby">
    <h1>@Texts.Lobby</h1>

    @if (!string.IsNullOrEmpty(_message))
    {
        <p class="toast error" role="alert">@_message <button type="button" class="link" @onclick="() => _message = null">@Texts.Dismiss</button></p>
    }

    @if (_view is not null)
    {
        <div class="card room-code">
            <span>@Texts.RoomCode</span>
            <strong class="code" data-testid="room-code">@_view.Code</strong>
            <button type="button" @onclick="CopyAsync">@(_copied ? Texts.Copied : Texts.Copy)</button>
        </div>

        <div class="card">
            <h2>@Texts.Players (@_view.Players.Count/@GameRoom.MaxPlayers)</h2>
            <ul class="player-list">
                @foreach (var player in _view.Players)
                {
                    <li>
                        <span class="name">@player.Name</span>
                        @if (player.IsHost) { <span class="badge">@Texts.Host</span> }
                        @if (player.IsNpc) { <span class="badge npc">@Texts.Npc</span> }
                        @if (player.Index == _view.ViewerIndex) { <span class="badge me">@Texts.You</span> }
                        @if (_view.IsViewerHost && player.IsNpc)
                        {
                            <button type="button" class="link" @onclick="() => RemoveNpcAsync(player.Id)">@Texts.RemoveNpc</button>
                        }
                    </li>
                }
            </ul>

            @if (_view.IsViewerHost)
            {
                <button type="button" disabled="@(_view.Players.Count >= GameRoom.MaxPlayers)" @onclick="AddNpcAsync">@Texts.AddNpc</button>
            }
        </div>

        <div class="card">
            <label for="board-size">@Texts.BoardSize</label>
            @if (_view.IsViewerHost)
            {
                <select id="board-size" value="@_view.BoardSize" @onchange="OnBoardSizeChanged">
                    @for (var size = MinBoardSize; size <= MaxBoardSize; size++)
                    {
                        <option value="@size" selected="@(size == _view.BoardSize)">@Texts.RoomBoard(size)</option>
                    }
                </select>
            }
            else
            {
                <strong>@Texts.RoomBoard(_view.BoardSize)</strong>
            }
        </div>

        <div class="actions">
            @if (_view.IsViewerHost)
            {
                <button type="button" class="primary" disabled="@(_view.Players.Count < 2)" @onclick="StartAsync">@Texts.StartGame</button>
                <p class="hint">@Texts.StartRule</p>
            }
            else
            {
                <p class="hint">@Texts.WaitingForHost</p>
            }
            <button type="button" @onclick="LeaveAsync">@Texts.LeaveRoom</button>
        </div>
    }
</main>

@code {
    private const int MinBoardSize = 6;
    private const int MaxBoardSize = 15;

    private GameRoom? _room;
    private BoardViewDto? _view;
    private IDisposable? _subscription;
    private Guid _playerId;
    private string? _message;
    private bool _copied;
    private bool _disposed;
    private int _refreshVersion;

    [Parameter] public string Code { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _playerId = Identity.GetOrCreatePlayerId();
        _room = Rooms.GetRoom(Code);
        if (_room is null)
        {
            Navigation.NavigateTo("/?notice=notfound");
            return;
        }

        _subscription = _room.Subscribe(OnRoomEvent);
        await RefreshAsync();
    }

    private void OnRoomEvent(RoomEvent roomEvent) => _ = HandleEventAsync();

    private async Task HandleEventAsync()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                if (_disposed)
                {
                    return;
                }

                await RefreshAsync();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private async Task RefreshAsync()
    {
        if (_room is null)
        {
            return;
        }

        var version = ++_refreshVersion;
        var view = await _room.GetViewAsync(_playerId);
        if (version != _refreshVersion || _disposed)
        {
            return;
        }

        _view = view;
        if (view.ViewerIndex < 0)
        {
            Navigation.NavigateTo($"/?notice=notmember&code={Uri.EscapeDataString(view.Code)}");
        }
        else if (view.State == RoomState.InProgress)
        {
            Navigation.NavigateTo($"/game/{view.Code}");
        }
        else if (view.State == RoomState.Finished)
        {
            Navigation.NavigateTo("/?notice=finished");
        }
    }

    private async Task RunAsync(Func<Task<RoomResult>> action)
    {
        var result = await action();
        _message = result.Success ? null : Texts.Error(result.Error);
        await RefreshAsync();
    }

    private Task AddNpcAsync() => RunAsync(() => _room!.AddNpcAsync(_playerId));

    private Task RemoveNpcAsync(Guid npcId) => RunAsync(() => _room!.RemoveNpcAsync(_playerId, npcId));

    private Task StartAsync() => RunAsync(() => _room!.StartGameAsync(_playerId));

    private Task OnBoardSizeChanged(ChangeEventArgs args) =>
        int.TryParse(args.Value?.ToString(), out var size)
            ? RunAsync(() => _room!.SetBoardSizeAsync(_playerId, size))
            : Task.CompletedTask;

    private async Task LeaveAsync()
    {
        var result = await _room!.LeaveAsync(_playerId);
        if (result.Success)
        {
            Navigation.NavigateTo("/?notice=left");
        }
        else
        {
            _message = Texts.Error(result.Error);
        }
    }

    private async Task CopyAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Code.Trim().ToUpperInvariant());
            _copied = true;
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException)
        {
        }
    }

    public void Dispose()
    {
        _disposed = true;
        _subscription?.Dispose();
    }
}
