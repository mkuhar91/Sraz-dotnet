<Window x:Class="Sraz.UI.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Sraz" Height="450" Width="800">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Sraz" FontSize="42" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Sraz-inspired .NET quiz game" Margin="0,8,0,16" HorizontalAlignment="Center"/>
            <Button Content="Start" Width="180" Height="40" Margin="0,0,0,8"/>
            <Button Content="Exit" Width="180" Height="40"/>
        </StackPanel>
    </Grid>
</Window>
