@page "/game/{Code}"
@namespace Sraz.UI.Blazor.Pages
@using Sraz.Application.Rooms
@using Sraz.Domain.Models
@implements IDisposable
@inject IRoomManager Rooms
@inject IPlayerIdentity Identity
@inject NavigationManager Navigation

<PageTitle>@Texts.AppName – @Code</PageTitle>

<main class="game">
    @if (!string.IsNullOrEmpty(_message))
    {
        <p class="toast error" role="alert">@_message <button type="button" class="link" @onclick="() => _message = null">@Texts.Dismiss</button></p>
    }

    @if (_view is not null)
    {
        <div class="game-layout">
            <section class="board-area">
                <p class="status-line" role="status">@StatusText</p>
                <Board View="_view" SelectedPawnId="_selectedPawnId" OnPawnSelected="SelectPawn" OnMoveSelected="MoveAsync" />
            </section>

            <aside class="side">
                @if (_view.State == RoomState.Finished)
                {
                    <GameOver View="_view" Disabled="_submitting" OnNewGame="NewGameAsync" />
                }

                <section class="players" aria-label="@Texts.Players">
                    <h3>@Texts.Players</h3>
                    <ul>
                        @foreach (var player in _view.Players)
                        {
                            <li class="@(player.Index == _view.CurrentPlayerIndex && _view.State == RoomState.InProgress ? "current" : string.Empty)">
                                <span class="dot" style="background:@player.Color"></span>
                                <span class="name">@player.Name</span>
                                @if (player.IsNpc) { <span class="badge npc">@Texts.Npc</span> }
                                @if (player.IsDisconnected) { <span class="badge disconnected">@Texts["Disconnected"]</span> }
                                @if (player.Index == _view.ViewerIndex) { <span class="badge me">@Texts.You</span> }
                                @if (player.Index == _view.CurrentPlayerIndex && _view.State == RoomState.InProgress) { <span class="badge turn">@Texts.OnTurn</span> }
                                <span class="pawns-left">@player.PawnsRemaining @Texts.PawnsLeft</span>
                            </li>
                        }
                    </ul>
                </section>

                <section class="notices" aria-label="@Texts.Notices">
                    <h3>@Texts.Notices</h3>
                    <ul>
                        @foreach (var notice in _notices)
                        {
                            <li>@notice</li>
                        }
                    </ul>
                </section>

                <Legend />
            </aside>
        </div>

        @if (_view.State == RoomState.InProgress && _view.IsViewerTurn && _question is not null)
        {
            @if (_question.IsDuel)
            {
                <DuelDialog Question="_question" Result="_duelResult" Disabled="_submitting" OnAnswer="AnswerAsync" OnClose="CloseDuel" />
            }
            else
            {
                <QuestionDialog Question="_question" Disabled="_submitting" OnAnswer="AnswerAsync" />
            }
        }
    }
</main>

@code {
    private const int MaxNotices = 6;

    private GameRoom? _room;
    private BoardViewDto? _view;
    private IDisposable? _subscription;
    private Guid _playerId;
    private Guid? _selectedPawnId;
    private QuestionDto? _question;
    private AnswerResultDto? _duelResult;
    private string? _message;
    private bool _submitting;
    private QuestionDto? _answeredQuestion;
    private bool _disposed;
    private int _refreshVersion;
    private readonly List<string> _notices = new();

    [Parameter] public string Code { get; set; } = string.Empty;

    private string StatusText
    {
        get
        {
            if (_view is null || _view.State == RoomState.Finished)
            {
                return Texts.GameOver;
            }

            if (_view.CurrentPlayerIndex < 0 || _view.CurrentPlayerIndex >= _view.Players.Count)
            {
                return string.Empty;
            }

            var current = _view.Players[_view.CurrentPlayerIndex].Name;
            if (_view.IsViewerTurn)
            {
                return _view.HasPendingQuestion ? Texts.Question : Texts.YourTurn;
            }

            return _view.HasPendingQuestion ? Texts.PlayerAnswering(current) : Texts.OnTurnPlayer(current);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_room?.Code.Equals(Code, StringComparison.OrdinalIgnoreCase) == true) return;
        _subscription?.Dispose();
        _subscription = null;
        _refreshVersion++;
        _view = null;
        _question = null;
        _duelResult = null;
        _answeredQuestion = null;
        _selectedPawnId = null;
        _notices.Clear();
        _playerId = Identity.GetOrCreatePlayerId();
        _room = Rooms.GetRoom(Code);
        if (_room is null)
        {
            Navigation.NavigateTo("/?notice=notfound");
            return;
        }

        _subscription = _room.Subscribe(OnRoomEvent);
        await RefreshAsync();
    }

    private void OnRoomEvent(RoomEvent roomEvent) => _ = HandleEventAsync(roomEvent);

    private async Task HandleEventAsync(RoomEvent roomEvent)
    {
        try
        {
            await InvokeAsync(async () =>
            {
                if (_disposed)
                {
                    return;
                }

                await RefreshAsync();
                AddNotice(roomEvent);
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private async Task RefreshAsync()
    {
        if (_room is null)
        {
            return;
        }

        var version = ++_refreshVersion;
        var view = await _room.GetViewAsync(_playerId);
        QuestionDto? pending = null;
        if (view.IsViewerTurn && view.HasPendingQuestion && _question is null)
        {
            pending = await _room.GetPendingQuestionAsync(_playerId);
        }

        if (version != _refreshVersion || _disposed)
        {
            return;
        }

        _view = view;
        if (view.ViewerIndex < 0 && !view.Players.Any(p => p.Id == _playerId || p.OriginalPlayerId == _playerId))
        {
            Navigation.NavigateTo($"/?notice=notmember&code={Uri.EscapeDataString(view.Code)}");
            return;
        }

        if (view.State == RoomState.Lobby)
        {
            Navigation.NavigateTo($"/lobby/{view.Code}");
            return;
        }

        if (!view.HasPendingQuestion || !view.IsViewerTurn)
        {
            if (_duelResult is null)
            {
                _question = null;
            }
        }
        else if (_question is null)
        {
            _question = pending;
        }

        if (!view.IsViewerTurn || view.HasPendingQuestion)
        {
            _selectedPawnId = null;
        }
    }

    private void SelectPawn(Guid pawnId) => _selectedPawnId = _selectedPawnId == pawnId ? null : pawnId;

    private async Task MoveAsync(MoveTargetDto target)
    {
        if (_submitting || _room is null)
        {
            return;
        }

        _submitting = true;
        try
        {
            var result = await _room.BeginMoveAsync(_playerId, target.PawnId, target.Direction);
            if (result.Success)
            {
                _message = null;
                _selectedPawnId = null;
                _duelResult = null;
                _question = result.Value;
            }
            else
            {
                _message = Texts.Error(result.Error);
            }
        }
        finally
        {
            _submitting = false;
        }

        await RefreshAsync();
    }

    private async Task AnswerAsync(int selectedIndex)
    {
        if (_submitting || _room is null || _question is null || _duelResult is not null || _answeredQuestion == _question)
        {
            return;
        }

        _submitting = true;
        _answeredQuestion = _question;
        var wasDuel = _question.IsDuel;
        try
        {
            var result = await _room.AnswerAsync(_playerId, selectedIndex);
            if (!result.Success)
            {
                _message = Texts.Error(result.Error);
                _answeredQuestion = null;
                if (result.Error is RoomError.NoPendingQuestion or RoomError.NotYourTurn or RoomError.NotInProgress)
                {
                    _question = null;
                }
                else if (_question is not null)
                {
                    // Re-enable this question only when the server rejected the answer.
                    _question = _question with { };
                }
            }
            else
            {
                _message = null;
                var answer = result.Value!;
                if (!answer.IsCompleted)
                {
                    _question = answer.NextQuestion;
                }
                else if (wasDuel)
                {
                    _duelResult = answer;
                }
                else
                {
                    _question = null;
                    AddNotice(answer.WasCorrect ? Texts.Correct : Texts.Wrong);
                }
            }
        }
        finally
        {
            _submitting = false;
        }

        await RefreshAsync();
    }

    private void CloseDuel()
    {
        _duelResult = null;
        _question = null;
    }

    private async Task NewGameAsync()
    {
        if (_submitting || _room is null || _view?.IsViewerHost != true) return;
        _submitting = true;
        try
        {
            var result = await _room.RestartAsync(_playerId);
            _message = result.Success ? null : Texts.Error(result.Error);
            await RefreshAsync();
        }
        finally
        {
            _submitting = false;
        }
    }

    private void AddNotice(RoomEvent roomEvent)
    {
        string NameOf(int? index) =>
            _view is not null && index is { } i && i >= 0 && i < _view.Players.Count ? _view.Players[i].Name : string.Empty;

        var text = roomEvent.Type switch
        {
            RoomEventType.PawnMoved => Texts.PawnMoved(NameOf(roomEvent.PlayerIndex)),
            RoomEventType.PawnCaptured => Texts.PawnCapturedOf(NameOf(roomEvent.PlayerIndex)),
            RoomEventType.TurnChanged => Texts.OnTurnPlayer(NameOf(roomEvent.PlayerIndex)),
            RoomEventType.GameFinished => Texts.GameOver,
            RoomEventType.PlayerDisconnected => Texts.PlayerDisconnected(NameOf(roomEvent.PlayerIndex)),
            RoomEventType.NpcTakeover => Texts.NpcTakeover(NameOf(roomEvent.PlayerIndex)),
            RoomEventType.PlayerReturned => Texts.PlayerReturned(NameOf(roomEvent.PlayerIndex)),
            RoomEventType.ActionResolved when roomEvent.Outcome == MoveOutcome.Stayed => Texts.PawnStayed(NameOf(roomEvent.PlayerIndex)),
            _ => null
        };
        if (text is not null)
        {
            AddNotice(text);
        }
    }

    private void AddNotice(string text)
    {
        _notices.Insert(0, text);
        if (_notices.Count > MaxNotices)
        {
            _notices.RemoveAt(_notices.Count - 1);
        }
    }

    public void Dispose()
    {
        _disposed = true;
        _subscription?.Dispose();
    }
}
