<Window x:Class="Sraz.UI.Wpf.QuestionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Sraz - Question" Height="500" Width="900">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Header}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="{Binding QuestionText}" TextWrapping="Wrap" FontSize="26" Margin="0,0,0,20"/>
            <ItemsControl ItemsSource="{Binding Options}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding}" Height="44" Margin="0,0,0,10" Click="Answer_Click"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="{Binding Footer}" HorizontalAlignment="Right" FontWeight="Bold"/>
    </Grid>
</Window>
