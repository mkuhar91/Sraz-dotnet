<Window x:Class="Sraz.UI.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Sraz.UI.Wpf.Localization"
        Title="Sraz" Height="560" Width="520" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="24">
        <TextBlock Text="Sraz" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock Text="{Binding [AppSubtitle], Source={x:Static loc:Localizer.Instance}}" HorizontalAlignment="Center" Margin="0,0,0,18"/>

        <TextBlock Text="{Binding [Language], Source={x:Static loc:Localizer.Instance}}"/>
        <ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="Label" SelectedValuePath="Value"
                  SelectedValue="{Binding SelectedLanguage}" Margin="0,2,0,10"/>

        <TextBlock Text="{Binding [PlayerName], Source={x:Static loc:Localizer.Instance}}"/>
        <TextBox Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,2,0,10"/>

        <TextBlock Text="{Binding [Mode], Source={x:Static loc:Localizer.Instance}}"/>
        <ComboBox ItemsSource="{Binding Modes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                  SelectedValue="{Binding SelectedMode}" Margin="0,2,0,2"/>
        <TextBlock Text="{Binding ModeDescription}" TextWrapping="Wrap" FontStyle="Italic" Margin="0,0,0,10"/>

        <TextBlock Text="{Binding [Category], Source={x:Static loc:Localizer.Instance}}"/>
        <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="Label" SelectedValuePath="Value"
                  SelectedValue="{Binding SelectedCategory}" IsEnabled="{Binding FiltersEnabled}" Margin="0,2,0,10"/>

        <TextBlock Text="{Binding [Difficulty], Source={x:Static loc:Localizer.Instance}}"/>
        <ComboBox ItemsSource="{Binding Difficulties}" DisplayMemberPath="Label" SelectedValuePath="Value"
                  SelectedValue="{Binding SelectedDifficulty}" IsEnabled="{Binding FiltersEnabled}" Margin="0,2,0,18"/>

        <Button Content="{Binding [StartGame], Source={x:Static loc:Localizer.Instance}}" Height="40" Margin="0,0,0,8" Click="Start_Click"/>
        <Button Content="{Binding [Leaderboard], Source={x:Static loc:Localizer.Instance}}" Height="40" Margin="0,0,0,8" Click="Leaderboard_Click"/>
        <Button Content="{Binding [Exit], Source={x:Static loc:Localizer.Instance}}" Height="40" Click="Exit_Click"/>
    </StackPanel>
</Window>
