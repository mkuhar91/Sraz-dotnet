<Window x:Class="Sraz.UI.Wpf.QuestionWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="Sraz" Height="640" Width="920" WindowStartupLocation="CenterOwner">
	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<DockPanel>
			<TextBlock Text="{Binding Header}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" DockPanel.Dock="Left"/>
			<TextBlock Text="{Binding TimeLeftText}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right"/>
		</DockPanel>

		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
			<StackPanel>
				<TextBlock Text="{Binding QuestionText}" TextWrapping="Wrap" FontSize="26" Margin="0,0,0,20"/>
				<Image Source="{Binding ImagePath}" Visibility="{Binding ImageVisible}" MaxHeight="200" Margin="0,0,0,15"/>
				<ItemsControl ItemsSource="{Binding Options}" Visibility="{Binding OptionsVisible}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Button Content="{Binding Text}" Height="44" Margin="0,0,0,10" Click="Answer_Click"
									IsEnabled="{Binding DataContext.CanAnswer, RelativeSource={RelativeSource AncestorType=Window}}"/>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
				<StackPanel Visibility="{Binding TextInputVisible}">
					<TextBlock Text="{Binding TypeAnswerLabel}" Margin="0,0,0,4"/>
					<TextBox Text="{Binding TextAnswer, UpdateSourceTrigger=PropertyChanged}" FontSize="20" Height="40"
							 IsEnabled="{Binding CanAnswer}" KeyDown="TextAnswer_KeyDown"/>
					<Button Content="{Binding SubmitLabel}" Height="40" Margin="0,10,0,0" Click="Submit_Click"
							IsEnabled="{Binding CanAnswer}"/>
				</StackPanel>
			</StackPanel>
		</ScrollViewer>

		<StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
			<Button Content="{Binding FiftyFiftyLabel}" Width="90" Height="34" Margin="0,0,8,0" Click="FiftyFifty_Click" IsEnabled="{Binding CanUseFiftyFifty}"/>
			<Button Content="{Binding ExtraTimeLabel}" Width="90" Height="34" Margin="0,0,8,0" Click="ExtraTime_Click" IsEnabled="{Binding CanUseExtraTime}"/>
			<Button Content="{Binding SkipLabel}" Width="90" Height="34" Click="Skip_Click" IsEnabled="{Binding CanSkip}"/>
		</StackPanel>

		<Border Grid.Row="3" Background="#222" CornerRadius="8" Padding="12" Margin="0,10,0,0" Visibility="{Binding FeedbackVisible}">
			<StackPanel>
				<TextBlock Text="{Binding FeedbackTitle}" FontWeight="Bold" Foreground="White"/>
				<TextBlock Text="{Binding FeedbackExplanation}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="White"/>
			</StackPanel>
		</Border>

		<TextBlock Grid.Row="4" Text="{Binding Footer}" HorizontalAlignment="Right" FontWeight="Bold" Margin="0,10,0,0"/>
	</Grid>
</Window>
