<span class="@CssClass">
    @if (Clickable)
    {
        <button type="button" class="pawn-button" aria-label="@Label" @onclick="OnClick" @onclick:stopPropagation="true">
            <PawnIcon Color="@Color" />
        </button>
    }
    else
    {
        <span class="pawn-static" aria-label="@Label" role="img">
            <PawnIcon Color="@Color" />
        </span>
    }
    @if (Acted)
    {
        <span class="acted-mark" aria-hidden="true">✓</span>
    }
</span>

@code {
    [Parameter] public string Color { get; set; } = "#555555";
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool Acted { get; set; }
    [Parameter] public bool Selected { get; set; }
    [Parameter] public bool Clickable { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private string CssClass =>
        "pawn" + (Acted ? " acted" : string.Empty) + (Selected ? " selected" : string.Empty) + (Clickable ? " clickable" : string.Empty);
}
