<Window x:Class="Sraz.UI.Wpf.BoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sraz - Board" Height="820" Width="1120" MinHeight="650" MinWidth="900"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="CurrentPlayerText" FontSize="22" FontWeight="Bold"/>
            <TextBlock x:Name="RemainingActionsText" FontSize="15"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <UniformGrid x:Name="BoardGrid" MinWidth="520" MinHeight="520"/>
            </ScrollViewer>
            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                <TextBlock x:Name="LegendTitle" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                <ItemsControl x:Name="ThemeLegend"/>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,14,0,0"/>
                <TextBlock x:Name="PlayerList" TextWrapping="Wrap" Margin="0,14,0,0"/>
            </StackPanel>
            <Border x:Name="GameOverPanel" Grid.ColumnSpan="2" Panel.ZIndex="2" Background="#F4FFFFFF"
                    BorderBrush="#333" BorderThickness="2" CornerRadius="12" Padding="30"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="WinnerText" FontSize="26" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,18"/>
                    <Button x:Name="NewGameButton" Height="42" Margin="0,0,0,8" Click="NewGame_Click"/>
                    <Button x:Name="ReturnButton" Height="42" Click="Return_Click"/>
                </StackPanel>
            </Border>
        </Grid>
        <TextBlock Grid.Row="2" x:Name="StatusBar" TextWrapping="Wrap" Margin="0,10,0,0"/>
    </Grid>
</Window>
